{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        },
        {
          "url": "mailto:*"
        }
      ]
    }
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  }
}
